{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "customers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "loans": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "payments": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "ledgerEntries": {
      ".read": "auth != null",
      "$entryId": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "auditLogs": {
      ".read": "auth != null",
      "$logId": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
