{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'laysonmngazija@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')"
      }
    },
    "customers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "loans": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "payments": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "ledgerEntries": {
      ".read": "auth != null && (auth.token.email === 'laysonmngazija@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
      "$entryId": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "auditLogs": {
      ".read": "auth != null && (auth.token.email === 'laysonmngazija@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
      "$logId": {
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
