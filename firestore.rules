rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Uthibitisho wa kuingia (Authenticated Admin au Agent)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Msimamizi Mkuu (Admin) pekee
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'laysonmngazija@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN')
      );
    }

    // Mfanyakazi aliyeidhinishwa (Admin au Agent pekee)
    function isStaff() {
      return isAuthenticated();
    }

    // Users Collection (Akaunti za Admin na Mawakala pekee)
    // Hakuna mtu wa nje (public) anayeweza kusoma au kuandika
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // Customers Collection (Wateja wa Mikopo - Admin & Agents tu)
    match /customers/{customerId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Loans Collection (Maombi, Idhini, na Utoaji Mikopo)
    match /loans/{loanId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Payments Collection (Marejesho ya Fedha Taslimu)
    match /payments/{paymentId} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // Ledger Entries (Daftari Kuu la Hesabu - Admin pekee anasoma, rekodi hazifutiki)
    match /ledgerEntries/{entryId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Notifications (Taarifa za Ndani)
    match /notifications/{notificationId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Messages (Mawasiliano na Shortcuts za Ujumbe)
    match /messages/{messageId} {
      allow read, write: if isStaff();
    }

    // Audit Logs (Kumbukumbu za Usalama - Hazifutiki wala kubadilishwa)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // Funga njia na folda nyingine zote (Hakuna ufikiaji wa hadharani / No public access)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
